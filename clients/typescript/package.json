{
  "name": "@clickwise/api",
  "version": "0.1.0",
  "description": "Thin, dependency-free TypeScript client for the Clickwise Publisher API (generated from its OpenAPI 3.1).",
  "license": "MIT",
  "type": "module",
  "main": "dist/clickwise.js",
  "types": "dist/clickwise.d.ts",
  "exports": {
    ".": {
      "types": "./dist/clickwise.d.ts",
      "default": "./dist/clickwise.js"
    }
  },
  "files": ["dist", "clickwise.ts"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": { "type": "git", "url": "git+https://github.com/softdevfz/clickwise-api.git", "directory": "clients/typescript" },
  "homepage": "https://partners.clickwise.net/developers/",
  "keywords": ["clickwise", "affiliate", "gtin", "product-catalog", "affiliate-links", "openapi"]
}
