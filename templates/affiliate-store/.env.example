# Clickwise publisher API key. Server-side only: never prefix it with NEXT_PUBLIC_.
# Get one at https://partners.clickwise.net/developers/
# Without it the store runs in preview mode (public sample, no tracked links).
CLICKWISE_API_KEY=

# Market: DE, ES, GB, PT, SE, FR or US.
CLICKWISE_COUNTRY=DE

# Products to show, by GTIN (comma-separated, 1-100). Takes precedence over the query.
CLICKWISE_GTINS=

# Used when CLICKWISE_GTINS is empty: products whose title contains this phrase.
CLICKWISE_QUERY=sneaker

# Storefront copy.
STORE_TITLE=Top Picks
STORE_TAGLINE=Hand-picked products with live prices.
